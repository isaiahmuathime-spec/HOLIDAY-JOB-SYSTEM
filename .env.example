# MongoDB Atlas Connection String
# Get this from your MongoDB Atlas dashboard
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/holiday-job-system?retryWrites=true&w=majority

# JWT Secret (change this to a random secure string)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Admin Signup Secret (for creating admin accounts)
ADMIN_SIGNUP_SECRET=your-admin-signup-secret-change-this

# Server Port
PORT=3000

# CORS Origin (optional, for production)
# CORS_ORIGIN=https://yourdomain.com